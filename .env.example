# =========================================================
# Employee Management System — Environment Configuration
# =========================================================
# Copy this file to .env and fill in the values below.
# IMPORTANT: Never put actual secret values in .env.
#            Use AWS Secrets Manager for all credentials.
# =========================================================

# ---------------------------------------------------------
# Server
# ---------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------
# AWS Configuration (Non-secret — safe in .env)
# ---------------------------------------------------------
AWS_REGION=us-east-1

# The name of your S3 bucket for employee photos
S3_BUCKET_NAME=your-employee-mgmt-bucket

# The ARN or Alias of your KMS key for salary encryption
# Example: arn:aws:kms:us-east-1:123456789012:key/your-key-id
#      or: alias/employee-salary-key
KMS_KEY_ID=alias/employee-salary-key

# ---------------------------------------------------------
# AWS Secrets Manager — Secret NAMES (not values!)
# These are just the names/ARNs of your secrets in AWS.
# The actual secret values are stored in Secrets Manager.
# ---------------------------------------------------------
SECRET_MONGO=emp-mgmt/mongodb
SECRET_ADMIN=emp-mgmt/admin-credentials
SECRET_JWT=emp-mgmt/jwt-secret
SECRET_SMTP=emp-mgmt/smtp-credentials
SECRET_SSH=emp-mgmt/ssh-private-key

# ---------------------------------------------------------
# AWS Credentials (Only needed for local dev without IAM Role)
# On EC2 with IAM Role attached, leave these commented out.
# ---------------------------------------------------------
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
