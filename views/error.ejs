<%- include('partials/header') %>
<div class="error-page">
  <div class="error-card">
    <div class="error-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
    <h1 class="error-title">Oops!</h1>
    <p class="error-message"><%= typeof message !== 'undefined' ? message : 'An unexpected error occurred.' %></p>
    <div class="d-flex gap-3 justify-content-center mt-4">
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/dashboard" class="btn btn-primary-custom">
          <i class="bi bi-house-fill me-2"></i>Go to Dashboard
        </a>
      <% } else { %>
        <a href="/login" class="btn btn-primary-custom">
          <i class="bi bi-box-arrow-in-right me-2"></i>Back to Login
        </a>
      <% } %>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
