<%- include('partials/header') %>

<div class="login-page">
  <!-- Background decorations -->
  <div class="login-bg-circle login-bg-circle-1"></div>
  <div class="login-bg-circle login-bg-circle-2"></div>
  <div class="login-bg-circle login-bg-circle-3"></div>

  <div class="login-container">

    <!-- Left Panel -->
    <div class="login-left">
      <div class="login-left-content">
        <div class="login-logo-wrap">
          <i class="bi bi-shield-lock-fill"></i>
        </div>
        <h1 class="login-title">Employee<br>Management<br>System</h1>
        <p class="login-description">
          A secure, cloud-native HR platform powered by AWS.
          Manage your workforce with enterprise-grade encryption and access controls.
        </p>
        <div class="login-features">
          <div class="login-feature">
            <i class="bi bi-key-fill"></i>
            <span>AWS Secrets Manager</span>
          </div>
          <div class="login-feature">
            <i class="bi bi-lock-fill"></i>
            <span>AWS KMS Encryption</span>
          </div>
          <div class="login-feature">
            <i class="bi bi-cloud-fill"></i>
            <span>AWS S3 Storage</span>
          </div>
          <div class="login-feature">
            <i class="bi bi-shield-check-fill"></i>
            <span>JWT Authentication</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Panel — Login Form -->
    <div class="login-right">
      <div class="login-card">

        <div class="login-card-header">
          <h2 class="login-card-title">Welcome Back</h2>
          <p class="login-card-subtitle">Sign in to access your dashboard</p>
        </div>

        <!-- Error Alert -->
        <% if (error) { %>
          <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
            <div><%= error %></div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <!-- Login Form -->
        <form action="/login" method="POST" id="loginForm" novalidate>

          <div class="form-floating mb-3">
            <input
              type="text"
              class="form-control"
              id="username"
              name="username"
              placeholder="Username"
              required
              autocomplete="username"
            >
            <label for="username">
              <i class="bi bi-person-fill me-1"></i> Username
            </label>
          </div>

          <div class="form-floating mb-4 position-relative">
            <input
              type="password"
              class="form-control"
              id="password"
              name="password"
              placeholder="Password"
              required
              autocomplete="current-password"
            >
            <label for="password">
              <i class="bi bi-lock-fill me-1"></i> Password
            </label>
            <button
              type="button"
              class="password-toggle"
              id="passwordToggle"
              tabindex="-1"
              aria-label="Toggle password visibility">
              <i class="bi bi-eye-fill" id="passwordToggleIcon"></i>
            </button>
          </div>

          <button type="submit" class="btn btn-login w-100" id="loginBtn">
            <span class="btn-text">
              <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
            </span>
            <span class="btn-loading d-none">
              <span class="spinner-border spinner-border-sm me-2" role="status"></span>
              Authenticating...
            </span>
          </button>

        </form>

        <div class="login-card-footer">
          <small>
            <i class="bi bi-info-circle me-1"></i>
            Credentials are securely stored in AWS Secrets Manager
          </small>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<!-- Custom JS -->
<script src="/js/main.js"></script>
</body>
</html>
