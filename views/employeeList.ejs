<%- include('partials/header') %>

<div class="app-layout">
  <%- include('partials/navbar', { currentPage: 'employees' }) %>

  <main class="main-content">

    <!-- Top Bar -->
    <div class="topbar">
      <div class="topbar-left">
        <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
          <i class="bi bi-list"></i>
        </button>
        <div class="page-breadcrumb">
          <a href="/dashboard" class="breadcrumb-home"><i class="bi bi-house-fill"></i></a>
          <span class="breadcrumb-sep">/</span>
          <span class="breadcrumb-current">Employees</span>
        </div>
      </div>
      <div class="topbar-right">
        <a href="/employees/add" class="btn btn-primary-custom btn-sm">
          <i class="bi bi-person-plus-fill me-1"></i>Add Employee
        </a>
      </div>
    </div>

    <!-- Page Content -->
    <div class="page-content">

      <div class="page-header">
        <div>
          <h1 class="page-title">Employee Directory</h1>
          <p class="page-subtitle">
            <span class="badge bg-primary-soft text-primary me-2"><%= employees.length %> employees</span>
            All salary data is encrypted at rest using AWS KMS
          </p>
        </div>
      </div>

      <!-- Alerts -->
      <% if (success) { %>
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
          <i class="bi bi-check-circle-fill flex-shrink-0"></i>
          <div><%= success %></div>
          <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
      <% } %>
      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
          <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
          <div><%= error %></div>
          <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <!-- Employee Table -->
      <div class="content-card">
        <div class="content-card-header d-flex justify-content-between align-items-center">
          <h5 class="content-card-title mb-0">
            <i class="bi bi-table me-2 text-primary"></i>All Employees
          </h5>
          <!-- Search -->
          <div class="table-search">
            <i class="bi bi-search"></i>
            <input type="text" id="tableSearch" placeholder="Search employees..." class="search-input">
          </div>
        </div>
        <div class="content-card-body p-0">

          <% if (employees.length === 0) { %>
            <div class="empty-state">
              <i class="bi bi-people"></i>
              <h4>No Employees Found</h4>
              <p>Get started by adding your first employee to the system.</p>
              <a href="/employees/add" class="btn btn-primary-custom">
                <i class="bi bi-person-plus-fill me-2"></i>Add First Employee
              </a>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="data-table" id="employeeTable">
                <thead>
                  <tr>
                    <th>Employee</th>
                    <th>Employee ID</th>
                    <th>Department</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Joined</th>
                    <th class="text-center">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% employees.forEach(function(emp) { %>
                    <tr class="table-row-animate" data-search="<%= emp.name.toLowerCase() %> <%= emp.employeeId.toLowerCase() %> <%= emp.department.toLowerCase() %> <%= emp.email.toLowerCase() %>">
                      <td>
                        <div class="employee-cell">
                          <% if (emp.photoUrl) { %>
                            <img src="<%= emp.photoUrl %>"
                                 alt="<%= emp.name %>"
                                 class="employee-avatar">
                          <% } else { %>
                            <div class="employee-avatar-placeholder">
                              <%= emp.name.charAt(0).toUpperCase() %>
                            </div>
                          <% } %>
                          <div class="employee-name-wrap">
                            <div class="employee-name"><%= emp.name %></div>
                            <div class="employee-id-badge">ID: <%= emp.employeeId %></div>
                          </div>
                        </div>
                      </td>
                      <td>
                        <code class="employee-id-code"><%= emp.employeeId %></code>
                      </td>
                      <td>
                        <span class="dept-badge"><%= emp.department %></span>
                      </td>
                      <td>
                        <a href="mailto:<%= emp.email %>" class="text-link">
                          <i class="bi bi-envelope me-1"></i><%= emp.email %>
                        </a>
                      </td>
                      <td class="text-muted"><%= emp.phone %></td>
                      <td class="text-muted">
                        <%= new Date(emp.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                      </td>
                      <td>
                        <div class="action-btns">
                          <a href="/employees/<%= emp._id %>"
                             class="action-btn action-btn-view"
                             title="View Details">
                            <i class="bi bi-eye-fill"></i>
                            <span>View</span>
                          </a>
                          <button
                            type="button"
                            class="action-btn action-btn-delete"
                            title="Delete Employee"
                            onclick="confirmDelete('<%= emp._id %>', '<%= emp.name %>', '<%= emp.employeeId %>')">
                            <i class="bi bi-trash-fill"></i>
                            <span>Delete</span>
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

    </div><!-- /page-content -->
  </main>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content modal-custom">
      <div class="modal-header modal-header-danger">
        <div class="modal-icon">
          <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
      </div>
      <div class="modal-body">
        <p>You are about to permanently delete:</p>
        <div class="delete-employee-info">
          <strong id="deleteEmployeeName">Employee Name</strong>
          <code id="deleteEmployeeId">EMP000</code>
        </div>
        <p class="text-danger mt-3">
          <i class="bi bi-exclamation-circle me-1"></i>
          <strong>This action cannot be undone.</strong>
          The employee record will be removed from MongoDB and their profile photo will be deleted from AWS S3.
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
          <i class="bi bi-x-lg me-1"></i>Cancel
        </button>
        <form id="deleteForm" method="POST" action="">
          <button type="submit" class="btn btn-danger" id="confirmDeleteBtn">
            <i class="bi bi-trash-fill me-1"></i>Delete Permanently
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
<script>
  function confirmDelete(id, name, employeeId) {
    document.getElementById('deleteEmployeeName').textContent = name;
    document.getElementById('deleteEmployeeId').textContent = employeeId;
    document.getElementById('deleteForm').action = `/employees/${id}/delete`;
    const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
    modal.show();
  }
</script>
</body>
</html>
